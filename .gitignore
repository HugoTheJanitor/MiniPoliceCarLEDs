# .gitignore for Arduino projects

# Arduino build artifacts
*.elf
*.hex
*.bin
*.eep
*.map
*.sym

# Object and library files
*.o
*.obj
*.a
*.lib
*.so
*.dll

# Precompiled headers and debug
*.gch
*.pch
*.dwo
*.pdb

# Build directories (Arduino IDE, CLI, PlatformIO)
build/
Build/
.pio/
.pioenvs/
.pioenvs/*

# Temporary and cache files
*.tmp
*.log
*.bak
*.swp
.cache/

# IDE/project files
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Keep other source and config files under version control (don't ignore):
# - platformio.ini (PlatformIO project config)
# - *.ino, *.h, *.cpp, README.md, etc.
